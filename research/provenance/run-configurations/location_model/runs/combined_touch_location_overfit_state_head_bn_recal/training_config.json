{
  "amp": true,
  "backbone": "mobilenet_v3_small",
  "batch_size": 32,
  "dataset_root": "/data/LocationData",
  "device": "cuda",
  "epochs": 75,
  "export_onnx": false,
  "hm_h": 40,
  "hm_sigma": 1.5,
  "hm_w": 60,
  "lambda_hm": 1.0,
  "lambda_state": 1.0,
  "lambda_touch": 1.0,
  "lambda_xy": 1.0,
  "log_every": 20,
  "lr": 0.0001,
  "margin_frac": 0.1,
  "num_workers": 4,
  "onnx_opset": 17,
  "onnx_path": "",
  "out_dir": "runs/combined_touch_location_overfit_state_head_bn_recal",
  "out_h": 320,
  "out_w": 480,
  "overfit_eval_train_subset": true,
  "overfit_loc_positive_only": false,
  "overfit_small": 128,
  "persistent_workers": true,
  "prefetch_factor": 2,
  "recalibrate_bn_before_eval": true,
  "require_any_label": false,
  "sampler_ratio_background": 0.25,
  "sampler_ratio_hover": 0.35,
  "sampler_ratio_touch": 0.4,
  "seed": 42,
  "touch_decision_threshold": 0.5,
  "touch_pressure_threshold": 0.0,
  "train_sampler": "three_state",
  "val_max_samples": 0,
  "version": "v1",
  "video_cache_size": 4,
  "weight_decay": 0.0001
}
