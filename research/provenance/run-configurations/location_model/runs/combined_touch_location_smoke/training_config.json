{
  "amp": true,
  "backbone": "mobilenet_v3_small",
  "batch_size": 128,
  "dataset_root": "/data/LocationData",
  "device": "cuda",
  "epochs": 2,
  "export_onnx": false,
  "hm_h": 40,
  "hm_sigma": 1.5,
  "hm_w": 60,
  "lambda_hm": 1.0,
  "lambda_touch": 1.0,
  "lambda_xy": 1.0,
  "log_every": 20,
  "lr": 0.0001,
  "margin_frac": 0.1,
  "num_workers": 8,
  "onnx_opset": 17,
  "onnx_path": "",
  "out_dir": "runs/combined_touch_location_smoke",
  "out_h": 320,
  "out_w": 480,
  "overfit_small": 512,
  "persistent_workers": true,
  "prefetch_factor": 4,
  "seed": 42,
  "touch_decision_threshold": 0.5,
  "touch_pressure_threshold": 0.0,
  "val_max_samples": 128,
  "version": "v1",
  "video_cache_size": 8,
  "weight_decay": 0.0001
}
