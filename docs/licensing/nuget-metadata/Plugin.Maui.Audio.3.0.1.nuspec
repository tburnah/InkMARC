    <dependencies>
      <group targetFramework="net8.0" />
      <group targetFramework="net8.0-android34.0" />
      <group targetFramework="net8.0-ios17.5" />
      <group targetFramework="net8.0-maccatalyst17.5" />
      <group targetFramework="net8.0-windows10.0.19041" />
    </dependencies>
  </metadata>
</package>